  "live": true,
  "availableRegions": ["IN"],
  "primaryLanguage": "en-IN",
  "audience": {
    "primary": "Indian B2B SMB sales teams",
    "teamSizeMin": 3,
    "teamSizeMax": 50,
    "industries": [
      "real-estate", "edtech", "bfsi", "manufacturing",
      "healthcare", "saas", "agencies", "retail",
      "logistics", "education", "fintech", "hospitality"
    ]
  },
  "pricing": {
    "currency": "INR",
    "unit": "flat per account per month (not per rep)",
    "tiers": [
      { "name": "Free", "price": 0, "seatCap": 1, "leadCap": 100 },
      { "name": "Starter", "price": 2999, "seatCap": 10, "leadCap": 5000 },
      { "name": "Growth", "price": 7999, "seatCap": 30, "leadCap": 25000, "mostPopular": true },
      { "name": "Scale", "price": 19999, "seatCap": 75, "leadCap": null },
      { "name": "Enterprise", "price": null, "seatCap": null, "note": "custom" }
    ],
