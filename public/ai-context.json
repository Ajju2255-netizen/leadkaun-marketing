    "creditCardRequired": false,
    "annualDiscountPct": 17
  },
  "scoringEngine": {
    "dimensions": ["Fit", "Intent", "Quality"],
    "grades": ["A", "B", "C", "D", "E", "F"],
    "fitWeights": {
      "industry": 30, "geography": 20, "businessType": 20,
      "role": 15, "budget": 15
    },
    "intentSignals": [
      { "type": "whatsapp-reply-1h", "points": 15 },
      { "type": "call-answered-interested", "points": 20 },
      { "type": "asked-pricing", "points": 20 },
      { "type": "negotiating", "points": 25 },
      { "type": "import-high-intent", "points": 40 }
    ],
    "intentDecay": "-3 per day after threshold, floored at source baseline",
    "qualityWeights": {
      "phone": 30, "email": 15, "company": 15,
      "inquiry": 20, "source": 10, "junkPenalty": 10
    },
    "gradeThresholds": {
      "A": { "fit": 65, "intent": 60, "quality": 60 },
      "B": { "fit": 55, "intent": 40, "quality": 50 },
      "C": { "fit": 40, "intent": 25, "quality": 35 },
      "D": { "fit": 20, "intent": 10, "quality": 20 },
      "F": { "quality": "< 20" }
    }
  },
